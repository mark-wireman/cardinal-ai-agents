{
  // VS Code workspace MCP config. The root key is "servers" (NOT "mcpServers",
  // which is the Cursor / Claude Desktop key). Commit this file to share the
  // server with your team; keep secrets in the user-level config instead.
  "servers": {
    "codebase-rag": {
      "type": "stdio",
      // Absolute path to the built server in THIS project. Replace the path.
      "command": "node",
      "args": ["/absolute/path/to/copilot-rag-mcp/dist/server.js"],
      "env": {
        // Index whatever repo is currently open in VS Code.
        "REPO_ROOT": "${workspaceFolder}",
        "OLLAMA_BASE_URL": "http://localhost:11434",
        "EMBED_MODEL": "nomic-embed-text",
        "CHROMA_URL": "http://localhost:8000",
        "COLLECTION": "codebase",
        "DEFAULT_TOP_K": "8",
        "DEFAULT_TOKEN_BUDGET": "2200"
      }
    }
  },
  "inputs": []
}
