# ---- Repository to index ----
# Absolute path to the codebase root you want Copilot to search.
REPO_ROOT=/absolute/path/to/your/repo

# ---- Ollama (local embeddings) ----
OLLAMA_BASE_URL=http://localhost:11434
# Embedding model. Pull it first with:  ollama pull nomic-embed-text
# Good alternatives: mxbai-embed-large (1024d, higher quality, slower)
EMBED_MODEL=nomic-embed-text

# ---- ChromaDB (local vector store) ----
# Start with: pip install chromadb && chroma run --path ./chroma_data --port 8000
CHROMA_URL=http://localhost:8000
COLLECTION=codebase

# ---- Chunking ----
# Max characters per chunk before a hard split (~ MAX_CHUNK_CHARS/4 tokens).
MAX_CHUNK_CHARS=1600
# Lines of overlap between adjacent chunks (preserves context across boundaries).
CHUNK_OVERLAP_LINES=12
# Target window size in lines before overlap.
CHUNK_WINDOW_LINES=55

# ---- Retrieval defaults (the cost levers) ----
# How many chunks search_code returns by default.
DEFAULT_TOP_K=8
# Hard token ceiling that get_context will never exceed when packing results.
DEFAULT_TOKEN_BUDGET=2200
# Embeddings are sent to Ollama in batches of this size during indexing.
EMBED_BATCH_SIZE=16
