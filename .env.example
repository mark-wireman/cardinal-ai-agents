# ============================================================================
# agents-deployment-package — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to source control (it is in .gitignore).
# ============================================================================

# ── Apigee / Gemini (required for MCP Server) ──────────────────────────────
APIGEE_ENDPOINT=https://your-apigee-endpoint/oauth2/v3/token/accesstoken?grant_type=client_credentials
APIGEE_KEY=your-apigee-api-key
APIGEE_SECRET=your-apigee-api-secret
GEMINI_ENDPOINT=https://your-apigee-endpoint/corp/genai

# ── RAG / Embeddings (optional — enables semantic code search) ──────────────
# Ollama must be running locally. Pull an embedding model first:
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# ChromaDB must be running locally:
#   pip install chromadb && chroma run --path ./chroma_data --port 8000
CHROMA_URL=http://localhost:8000
COLLECTION=codebase

# The repo to index for semantic search (defaults to current directory)
REPO_ROOT=.

# ── RAG Tuning (sensible defaults — adjust for cost/quality) ────────────────
DEFAULT_TOP_K=8
DEFAULT_TOKEN_BUDGET=2200
MAX_CHUNK_CHARS=1600
CHUNK_OVERLAP_LINES=12
CHUNK_WINDOW_LINES=55
EMBED_BATCH_SIZE=16
