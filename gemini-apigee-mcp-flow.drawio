<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="Gemini-Apigee MCP Flow" id="2">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Start -->
        <mxCell id="2" value="Start" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="100" height="60" as="geometry" />
        </mxCell>
        <!-- User sends prompt -->
        <mxCell id="3" value="User sends prompt" style="rectangle;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="180" y="40" width="160" height="60" as="geometry" />
        </mxCell>
        <!-- MCP Server receives -->
        <mxCell id="4" value="MCP Server receives" style="rectangle;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="160" height="60" as="geometry" />
        </mxCell>
        <!-- Check token cache -->
        <mxCell id="5" value="Check token cache" style="rectangle;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="580" y="40" width="160" height="60" as="geometry" />
        </mxCell>
        <!-- Token valid? -->
        <mxCell id="6" value="Token valid?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="780" y="40" width="100" height="60" as="geometry" />
        </mxCell>
        <!-- Yes branch -->
        <mxCell id="7" value="Use cached token" style="rectangle;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#b7e1cd;" vertex="1" parent="1">
          <mxGeometry x="900" y="20" width="140" height="40" as="geometry" />
        </mxCell>
        <!-- No branch -->
        <mxCell id="8" value="Request new token from Apigee" style="rectangle;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#b7e1cd;" vertex="1" parent="1">
          <mxGeometry x="900" y="80" width="180" height="40" as="geometry" />
        </mxCell>
        <!-- Call Gemini -->
        <mxCell id="9" value="Call Gemini API" style="rectangle;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="1120" y="40" width="160" height="60" as="geometry" />
        </mxCell>
        <!-- Return response -->
        <mxCell id="10" value="Return Gemini response" style="rectangle;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="1320" y="40" width="160" height="60" as="geometry" />
        </mxCell>
        <!-- End -->
        <mxCell id="11" value="End" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="1520" y="40" width="100" height="60" as="geometry" />
        </mxCell>
        <!-- Arrows -->
        <mxCell id="12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Token valid decision -->
        <mxCell id="16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;" edge="1" parent="1" source="6" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Both branches go to Gemini -->
        <mxCell id="18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;" edge="1" parent="1" source="7" target="9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;" edge="1" parent="1" source="8" target="9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;" edge="1" parent="1" source="9" target="10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;" edge="1" parent="1" source="10" target="11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
